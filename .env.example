# Required: generate a long random value, e.g. openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=60

# Prompt injection classifier
CLASSIFIER_PATH=models/prompt_injection_pipeline.joblib
INJECTION_THRESHOLD=0.80

# Hugging Face Inference Providers (SLM)
HF_TOKEN=
HF_SLM_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local SQLite database
DATABASE_URL=sqlite:///./gateway.db
